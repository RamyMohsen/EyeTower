<html>

<%- include("./partials/head.ejs") %>

    <body>
        <%- include("./partials/nav.ejs") %>
            <div class="container-profile">
                <div class="profile-name">
                    <h3>Name:</h3>
                    <p id="name" contenteditable="false"><%=user.name%></p>
                </div>
                <div class="profile-details">
                    <h3>Type:</h3>
                    <p id="type" contenteditable="false"><%=user.type%></p>
                </div>
                <div class="profile-details">
                    <h3>Email:</h3>
                    <p id="email" contenteditable="false"><%=user.email%></p>
                </div>
                <div class="profile-details">
                    <h3>Password:</h3>
                    <p id="password" contenteditable="false"><%=user.password%></p>
                </div>
                <div class="action-buttons">
                    <a class="edit fas fa-edit" data-doc="<%= user.account_id %>" id="edit"></a>
                </div>
                <% if(typeof error !=='undefined' ) { %>
                    <p class="msg" style="color:red">
                        <%= error %>
                    </p>
                    <% } %>
                        <% if(typeof success !=='undefined' ) { %>
                            <p class="msg" style="color:rgb(0, 255, 0)">
                                <%= success %>
                            </p>
                            <% } %>
            </div>
            <script>
                const edit = document.getElementById('edit')
                edit.addEventListener('click', function () {
                    event.preventDefault()
                    var name = document.getElementById('name');
                    var type = document.getElementById('type');
                    var email = document.getElementById('email');
                    var password = document.getElementById('password');
                    if (name.isContentEditable) {
                        name.contentEditable = 'false';
                        type.contentEditable = 'false';
                        email.contentEditable = 'false';
                        password.contentEditable = 'false';
                        // TODO: Save changes to server
                        var data = {
                            'name': name.innerHTML,
                            'type': type.innerHTML,
                            'email': email.innerHTML,
                            'password': password.innerHTML
                        };

                        const endpoint = `/update_user/${edit.dataset.doc}`;

                        fetch(endpoint, {
                            method: "PUT",
                            headers: { "Content-Type": "application/json" },
                            body: JSON.stringify(data)
                        })
                            .then(response => response.json())
                            .then(data => window.location.href = data.redirect)
                            .catch(err => console.log(err));
                        edit.classList.add("fa-edit");
                        edit.classList.remove("fa-save");
                    } else {
                        name.contentEditable = 'true';
                        type.contentEditable = 'true';
                        email.contentEditable = 'true';
                        password.contentEditable = 'true';
                        edit.classList.remove("fa-edit");
                        edit.classList.add("fa-save");
                    }
                });
            </script>
    </body>

</html>