<html>

<%- include("./partials/head.ejs") %>

    <body>
        <%- include("./partials/nav.ejs") %>
            <div class="container">
                <h2>Choose Recorded Video</h2>
                <label for="video-select">Select a Video:</label>
                <select id="video-select" name="videoFile">
                    <option value="none">None</option>
                    <% videos.forEach(video=> { %>
                        <option value="<%= video.filePath %>"">
                            <%= video.title %>
                        </option>
                        <% }); %>
                </select>
                <video id="video-element" autoplay controls></video>
            </div>
            <script>
                var videoSelect = document.getElementById('video-select');
                var videoElement = document.getElementById('video-element');
    
                videoSelect.addEventListener('change', function () {
                    var selectedVideo = videoSelect.value;
                    if (selectedVideo === 'none') {
                        videoElement.src = '';
                        videoElement.style.display = 'none';
                    } else {
                        // Set the source of the video element to the selected video file
                        videoElement.src = '/videos/' + selectedVideo;
                        videoElement.load();
                        videoElement.style.display = 'block';
                    }
                });
            </script>
    </body>
</html>