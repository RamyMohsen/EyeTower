<html>

<%- include("./partials/head.ejs") %>

    <body>
        <%- include("./partials/nav.ejs") %>
            <div class="container">
                <h2>Alerts</h2>
                <% if (alerts.length> 0) { %>
                    <% alerts.forEach(alert=> { %>
                        <div class="alert-card">
                            <div class="alert-card-content">
                                <%= alert.description %>
                            </div>
                            <div class="alert-card-severity"><b>Severity:</b>
                                <%= alert.severity %>
                            </div>
                            <div class="alert-card-time"><b>Date:</b>
                                <% let date = new Date(alert.timestamp)%>
                                <%= date.toLocaleString() %>
                            </div>
                        </div>
                        <% }) %>
                            <% } else { %>
                                <p>There are no alerts to display...</p>
                                <% } %>
            </div>
    </body>
</html>