    <h1>Welcome <%= user.name %></h1>
    <body>
        <div class="container">
          <h2> What do you want to do today</h2>
          <% if (user.type === 'user') { %>
          <!-- User Section -->
          <div class="user-section">
            <a href="#" class="button">View Live Feed</a>
            <a href="#" class="button">Find Person</a>
            <a href="#" class="button">Playback Recording</a>
          </div>
          <% } else { %>
          <!-- Admin Section -->
          <div class="admin-section">
            <a href="#" class="button">Add User</a>
            <a href="#" class="button">Modify User Profile</a>
            <a href="#" class="button">Add Person</a>
            <a href="#" class="button">Modify Person Profile</a>
            <a href="#" class="button">List All Users</a>
            <a href="#" class="button">List All Persons</a>
            <a href="#" class="button">View System Alerts</a>
            <a href="#" class="button">Add Camera</a>
